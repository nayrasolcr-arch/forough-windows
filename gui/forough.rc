// Windows resources for Forough (forough.exe): application icon + version
// info. Compiled with x86_64-w64-mingw32-windres via Meson's windows module.
1 ICON "forough.ico"

1 VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "Forough contributors"
      VALUE "FileDescription",  "Forough — a bright window to the open internet"
      VALUE "FileVersion",      "2.0.0.0"
      VALUE "InternalName",     "forough"
      VALUE "LegalCopyright",   "GPL-3.0-or-later"
      VALUE "OriginalFilename", "forough.exe"
      VALUE "ProductName",      "Forough Client"
      VALUE "ProductVersion",   "2.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
